# =====================================================================
# Variáveis de ambiente do banco de dados (PostgreSQL / NeonDB)
# Copie este arquivo para ".env" e preencha com os valores reais do Neon.
# O ".env" NÃO deve ser commitado (já está no .gitignore).
# =====================================================================

# String de conexão JDBC do Neon. O Neon EXIGE SSL (sslmode=require).
# Pegue o host/banco no painel do Neon (Connection Details -> JDBC).
# Exemplo:
#   jdbc:postgresql://ep-xxxx-xxxx.sa-east-1.aws.neon.tech/sanem?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-neon>/<database>?sslmode=require

# Usuário e senha do banco no Neon
SPRING_DATASOURCE_USERNAME=<usuario-neon>
SPRING_DATASOURCE_PASSWORD=<senha-neon>

# Perfil da aplicação:
#   dev  -> aplica o schema E o seed de dados de exemplo (usuários, pontos, etc.)
#   prod -> aplica SOMENTE o schema; nenhum dado é inserido (cadastro manual)
# Use "dev" no banco de desenvolvimento do Neon e "prod" no banco de produção.
SPRING_PROFILES_ACTIVE=dev
